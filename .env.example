# Required: your OpenAI API key (platform.openai.com → API keys). Starts with sk-
OPENAI_API_KEY=
# Required: the password you type to open your dashboard
APP_PASSWORD=
# Added automatically by Vercel when you connect a Blob store
BLOB_READ_WRITE_TOKEN=
# Optional model overrides
OPENAI_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
